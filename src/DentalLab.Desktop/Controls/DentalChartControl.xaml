<UserControl x:Class="DentalLab.Desktop.Controls.DentalChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:DentalLab.Desktop.Services"
             x:Name="Self">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="3" HorizontalAlignment="Left" Height="40">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="PermanentRadio" Style="{StaticResource SegmentedRadio}" IsChecked="True"
                                 Content="{Binding [Dentition_Permanent], Source={x:Static svc:LocalizationService.Instance}}" />
                    <RadioButton x:Name="PrimaryRadio" Style="{StaticResource SegmentedRadio}"
                                 Content="{Binding [Dentition_Primary], Source={x:Static svc:LocalizationService.Instance}}" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="SummaryLabel" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <Button x:Name="ClearButton" Style="{StaticResource GhostButton}" Height="34" MinWidth="64" FontSize="12"
                        Padding="12,0" Click="OnClearClicked"
                        Content="{Binding [Chart_Clear], Source={x:Static svc:LocalizationService.Instance}}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Viewbox Stretch="Uniform">
                <Grid Width="760" Height="480">
                    <Canvas x:Name="PermanentCanvas" />
                    <Canvas x:Name="PrimaryCanvas" Visibility="Collapsed" />
                </Grid>
            </Viewbox>

            <Border x:Name="DetailCard" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22,12" MinWidth="170">
                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.12" Color="Black" /></Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="DetailNumber" FontSize="30" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"
                               TextAlignment="Center" />
                    <TextBlock x:Name="DetailName" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                               TextAlignment="Center" />
                    <TextBlock x:Name="DetailMeta" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               TextAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <ItemsControl x:Name="Chips" Grid.Row="2" Margin="0,8,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource GoldBrush}" CornerRadius="10" Padding="10,3" Margin="0,0,6,6">
                        <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
