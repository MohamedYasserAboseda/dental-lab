<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme: only semantic brushes live here. Swapped at runtime by ThemeService. -->
    <SolidColorBrush x:Key="BgBrush" Color="#0B1424" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#14233D" />
    <SolidColorBrush x:Key="TextBrush" Color="#EEF2F8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9AA6B8" />
    <SolidColorBrush x:Key="BorderBrush" Color="#243656" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0A1220" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#E8ECF3" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#172B49" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#1B2F52" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#C6A15B" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#1B2F52" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#223A63" />
    <SolidColorBrush x:Key="ToothFillBrush" Color="#DDE5F1" />
    <SolidColorBrush x:Key="ToothStrokeBrush" Color="#7F8DA6" />
</ResourceDictionary>
