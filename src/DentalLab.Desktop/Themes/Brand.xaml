<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="NavyColor">#101D35</Color>
    <Color x:Key="NavySecondaryColor">#172B49</Color>
    <Color x:Key="GoldColor">#C6A15B</Color>
    <SolidColorBrush x:Key="GoldBrush" Color="#C6A15B" />
    <SolidColorBrush x:Key="NavyBrush" Color="#101D35" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#259B73" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E6A23C" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D9534F" />
    <CornerRadius x:Key="CardRadius">16</CornerRadius>
</ResourceDictionary>
