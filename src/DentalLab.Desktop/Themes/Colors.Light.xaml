<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme: only semantic brushes live here. Swapped at runtime by ThemeService. -->
    <SolidColorBrush x:Key="BgBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#101D35" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7686" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E3E8EF" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#101D35" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#E8ECF3" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#172B49" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#1F355A" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#101D35" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F0F3F8" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#E8EDF5" />
    <SolidColorBrush x:Key="ToothFillBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToothStrokeBrush" Color="#B7C0CE" />
</ResourceDictionary>
