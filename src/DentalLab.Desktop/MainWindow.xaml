<Window x:Class="DentalLab.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:DentalLab.Desktop.Services"
        xmlns:vm="clr-namespace:DentalLab.Desktop.ViewModels"
        xmlns:views="clr-namespace:DentalLab.Desktop.Views"
        Title="Dental Lab Management System" Width="1360" Height="820" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FlowDirection="{Binding FlowDirection, Source={x:Static svc:LocalizationService.Instance}}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupViewModel}"><views:BackupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PatientsViewModel}"><views:PatientsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CasesViewModel}"><views:CasesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorkflowViewModel}"><views:WorkflowView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvoicesViewModel}"><views:InvoicesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PaymentsViewModel}"><views:PaymentsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DoctorAccountsViewModel}"><views:DoctorAccountsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DoctorsViewModel}">
            <views:DoctorsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border x:Name="Sidebar" Grid.Column="0" Width="264" Background="{DynamicResource SidebarBrush}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Height="72" Margin="12,0,12,8">
                    <Viewbox Width="48" Height="30" Margin="0">
                        <Path Data="{StaticResource ToothGeometry}" Stroke="{StaticResource GoldBrush}" Fill="#22C6A15B"
                              StrokeThickness="4" StrokeLineJoin="Round" Width="100" Height="100" Stretch="Uniform" />
                    </Viewbox>
                    <TextBlock Text="{Binding Loc[App_ShortName]}" Foreground="White" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <ListBox Grid.Row="1" Style="{StaticResource NavListBox}" ItemContainerStyle="{StaticResource NavItem}"
                         ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}" />

                <TextBlock Grid.Row="2" Text="{Binding VersionText}" Foreground="#80E8ECF3" FontSize="11"
                           Margin="24,10,24,16" />
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource IconButton}" Content="&#xE700;"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="{Binding Loc[Tip_ToggleSidebar]}" />

                    <Border Grid.Column="1" Background="{DynamicResource BgBrush}" CornerRadius="12" Height="42"
                            Width="380" HorizontalAlignment="Left" Margin="16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="14,0,8,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                         VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                                         CaretBrush="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding Loc[Top_Search]}" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Margin="2,0,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentDateText}" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Style="{StaticResource IconButton}" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="14"
                                Content="{Binding Loc.LanguageToggleLabel}" Command="{Binding ToggleLanguageCommand}"
                                ToolTip="{Binding Loc[Tip_Language]}" />
                        <Button Style="{StaticResource IconButton}" Content="{Binding ThemeGlyph}"
                                Command="{Binding ToggleThemeCommand}" ToolTip="{Binding Loc[Tip_Theme]}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE7ED;"
                                ToolTip="{Binding Loc[Tip_Notifications]}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;"
                                Command="{Binding OpenSettingsCommand}" ToolTip="{Binding Loc[Tip_Settings]}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page host -->
            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="28" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
