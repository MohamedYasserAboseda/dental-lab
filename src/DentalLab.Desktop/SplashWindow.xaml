<Window x:Class="DentalLab.Desktop.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:DentalLab.Desktop.Services"
        Width="540" Height="400" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding FlowDirection, Source={x:Static svc:LocalizationService.Instance}}">
    <Grid x:Name="Root" Margin="18">
        <Border CornerRadius="24">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#101D35" Offset="0" />
                    <GradientStop Color="#172B49" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.35" Color="Black" /></Border.Effect>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="110" Height="110" Margin="0,0,0,18" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                    <Viewbox>
                        <Path Data="{StaticResource ToothGeometry}" Stroke="#C6A15B" Fill="#22C6A15B"
                              StrokeThickness="2.5" StrokeLineJoin="Round" Width="100" Height="100" Stretch="Uniform" />
                    </Viewbox>
                </Grid>
                <TextBlock Text="{Binding [App_Name], Source={x:Static svc:LocalizationService.Instance}}"
                           Foreground="White" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="{Binding [Splash_Tagline], Source={x:Static svc:LocalizationService.Instance}}"
                           Foreground="#C6A15B" FontSize="13" Margin="0,6,0,26" TextAlignment="Center" />
                <Grid Width="36" Height="36" HorizontalAlignment="Center">
                    <Ellipse Stroke="#33FFFFFF" StrokeThickness="3" />
                    <Grid x:Name="Spinner" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><RotateTransform x:Name="SpinnerRotate" /></Grid.RenderTransform>
                        <Path Data="M 18,1.5 A 16.5,16.5 0 0 1 34.5,18" Stroke="#C6A15B" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                </Grid>
                <TextBlock Text="{Binding [Splash_Loading], Source={x:Static svc:LocalizationService.Instance}}"
                           Foreground="#99FFFFFF" FontSize="12" Margin="0,14,0,0" TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
