<views:DialogWindowBase x:Class="DentalLab.Desktop.Views.PatientEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DentalLab.Desktop.Views" xmlns:helpers="clr-namespace:DentalLab.Desktop.Helpers" xmlns:controls="clr-namespace:DentalLab.Desktop.Controls" xmlns:vm="clr-namespace:DentalLab.Desktop.ViewModels"
        Style="{StaticResource DialogWindow}" Width="560">
    
    <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_FullName]}" />
            <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"  />
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Doctor]}" />
            <ComboBox Style="{StaticResource PremiumComboBox}" ItemsSource="{Binding Doctors}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedDoctorId}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_PatientCode]}" />
            <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"  />
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Notes]}" />
            <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" VerticalContentAlignment="Top" />
            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,14,0,0">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                    <DataTrigger Binding="{Binding ErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style></TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Style="{StaticResource GhostButton}" Content="{Binding Loc[Common_Cancel]}" Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="{Binding Loc[Common_Save]}" Command="{Binding SaveCommand}" />
            </StackPanel>
    </StackPanel>
</views:DialogWindowBase>
