<Window x:Class="DentalLab.Desktop.Views.PrintPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svc="clr-namespace:DentalLab.Desktop.Services" xmlns:views="clr-namespace:DentalLab.Desktop.Views" xmlns:helpers="clr-namespace:DentalLab.Desktop.Helpers" xmlns:controls="clr-namespace:DentalLab.Desktop.Controls" xmlns:vm="clr-namespace:DentalLab.Desktop.ViewModels"
        Title="{Binding Title}" Width="980" Height="860" MinWidth="720" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" FlowDirection="{Binding FlowDirection, Source={x:Static svc:LocalizationService.Instance}}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="2,0,0,4" Text="{Binding Loc[Preview_Format]}" />
                        <ComboBox Style="{StaticResource PremiumComboBox}" Width="190" ItemsSource="{Binding FormatOptions}" DisplayMemberPath="Name"
                                  SelectedValuePath="Id" SelectedValue="{Binding SelectedFormatId}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="2,0,0,4" Text="{Binding Loc[Preview_Language]}" />
                        <ComboBox Style="{StaticResource PremiumComboBox}" Width="150" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Name"
                                  SelectedValuePath="Id" SelectedValue="{Binding SelectedLanguageId}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" Margin="18,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding StatusText}" Foreground="{StaticResource SuccessBrush}"
                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" IsEnabled="{Binding CanUseDocument}">
                    <Button Style="{StaticResource GhostButton}" Content="{Binding Loc[Preview_Open]}" Command="{Binding OpenInViewerCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource GhostButton}" Content="{Binding Loc[Preview_Save]}" Command="{Binding SavePdfCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding Loc[Doc_Print]}" Command="{Binding PrintCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Pages}" HorizontalAlignment="Center" Margin="0,22">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" Margin="0,0,0,18" HorizontalAlignment="Center">
                                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25" Color="Black" /></Border.Effect>
                                <Image Source="{Binding}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                       Width="{Binding DataContext.PageWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="{Binding Loc[Backup_Working]}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"
                       Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</Window>
