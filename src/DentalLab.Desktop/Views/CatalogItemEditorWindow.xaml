<views:DialogWindowBase x:Class="DentalLab.Desktop.Views.CatalogItemEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DentalLab.Desktop.Views" xmlns:helpers="clr-namespace:DentalLab.Desktop.Helpers" xmlns:controls="clr-namespace:DentalLab.Desktop.Controls" xmlns:vm="clr-namespace:DentalLab.Desktop.ViewModels"
        Style="{StaticResource DialogWindow}" Width="520">
    
    <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Name]}" />
            <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"  />
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_NameAr]}" />
            <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding NameAr, UpdateSourceTrigger=PropertyChanged}"  />
            <StackPanel Visibility="{Binding ShowPrice, Converter={StaticResource BoolToVis}}"><TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_DefaultPrice]}" /><TextBox Style="{StaticResource FieldTextBox}" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" /></StackPanel>
            <CheckBox Content="{Binding Loc[Field_Active]}" IsChecked="{Binding IsActive}" Margin="0,16,0,0" Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,14,0,0">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                    <DataTrigger Binding="{Binding ErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style></TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Style="{StaticResource GhostButton}" Content="{Binding Loc[Common_Cancel]}" Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="{Binding Loc[Common_Save]}" Command="{Binding SaveCommand}" />
            </StackPanel>
    </StackPanel>
</views:DialogWindowBase>
