<UserControl x:Class="DentalLab.Desktop.Views.BackupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DentalLab.Desktop.Views" xmlns:helpers="clr-namespace:DentalLab.Desktop.Helpers" xmlns:controls="clr-namespace:DentalLab.Desktop.Controls" xmlns:vm="clr-namespace:DentalLab.Desktop.ViewModels">
    <UserControl.Resources><helpers:BindingProxy x:Key="Proxy" Data="{Binding}" /></UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding Loc[Nav_Backup]}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,18" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,16" BorderBrush="{StaticResource GoldBrush}" Visibility="{Binding IsRestartNeeded, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Loc[Backup_RestoreScheduled]}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{Binding Loc[Backup_RestartNow]}" Command="{Binding RestartNowCommand}" Margin="16,0,0,0" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16" BorderBrush="{StaticResource GoldBrush}" Visibility="{Binding IsConfirmOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Backup_RestoreTitle]}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="{Binding ConfirmFileName}" Foreground="{StaticResource GoldBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Loc[Backup_RestoreWarning]}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding Loc[Backup_RestoreConfirm]}" Command="{Binding ConfirmRestoreCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource GhostButton}" Content="{Binding Loc[Common_Cancel]}" Command="{Binding CancelRestoreCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding Loc[Backup_Create]}" Command="{Binding CreateBackupCommand}" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="{Binding Loc[Backup_Check]}" Command="{Binding CheckIntegrityCommand}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource GhostButton}" Content="{Binding Loc[Backup_OpenFolder]}" Command="{Binding OpenFolderCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Margin="0,16,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"
                                   Foreground="{StaticResource SuccessBrush}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[Backup_Auto]}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <CheckBox Content="{Binding Loc[Backup_AutoEnable]}" IsChecked="{Binding AutoEnabled, Mode=TwoWay}" Margin="0,12,0,0" Foreground="{DynamicResource TextBrush}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Backup_Interval]}" />
                                <ComboBox Style="{StaticResource PremiumComboBox}" ItemsSource="{Binding IntervalOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding IntervalHours, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Backup_Retention]}" />
                                <ComboBox Style="{StaticResource PremiumComboBox}" ItemsSource="{Binding RetentionOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding RetentionCount, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="{Binding Loc[Backup_Compress]}" IsChecked="{Binding Compress, Mode=TwoWay}" Margin="0,16,0,0" Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="20,18,20,12">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Backup_History]}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                    <Grid>
                        <DataGrid Style="{StaticResource PremiumDataGrid}" ItemsSource="{Binding Items}" RowHeight="48" MaxHeight="420" VerticalScrollBarVisibility="Auto" MinHeight="60">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Data.Loc[Col_Date], Source={StaticResource Proxy}}" Binding="{Binding DateText}" Width="160" />
                                <DataGridTextColumn Header="{Binding Data.Loc[Col_Type], Source={StaticResource Proxy}}" Binding="{Binding KindText}" Width="140" />
                                <DataGridTextColumn Header="{Binding Data.Loc[Col_Size], Source={StaticResource Proxy}}" Binding="{Binding SizeText}" Width="100" />
                                <DataGridTextColumn Header="{Binding Data.Loc[Col_File], Source={StaticResource Proxy}}" Binding="{Binding FileName}" Width="*" />
                                <DataGridTemplateColumn Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Height="32" MinWidth="60" FontSize="12" Padding="10,0" Margin="0,0,8,0"
                                                Content="{Binding Data.Loc[Backup_Verify], Source={StaticResource Proxy}}"
                                                Command="{Binding DataContext.VerifyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource GhostButton}" Height="32" MinWidth="60" FontSize="12" Padding="10,0"
                                                Content="{Binding Data.Loc[Backup_Restore], Source={StaticResource Proxy}}"
                                                Command="{Binding DataContext.StartRestoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding Loc[Backup_Empty]}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding HasNoBackups, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
