<views:DialogWindowBase x:Class="DentalLab.Desktop.Views.PatientHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DentalLab.Desktop.Views" xmlns:helpers="clr-namespace:DentalLab.Desktop.Helpers" xmlns:controls="clr-namespace:DentalLab.Desktop.Controls" xmlns:vm="clr-namespace:DentalLab.Desktop.ViewModels"
        Style="{StaticResource DialogWindow}" Width="900">
    <views:DialogWindowBase.Resources><helpers:BindingProxy x:Key="Proxy" Data="{Binding}" /></views:DialogWindowBase.Resources>
    <StackPanel>
        <Grid>
            <DataGrid Style="{StaticResource PremiumDataGrid}" ItemsSource="{Binding Items}" MaxHeight="400" MinHeight="70" RowHeight="46" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding Data.Loc[Col_CaseNumber], Source={StaticResource Proxy}}" Binding="{Binding CaseNumber}" Width="140" />
                    <DataGridTextColumn Header="{Binding Data.Loc[Col_Restoration], Source={StaticResource Proxy}}" Binding="{Binding RestorationText}" Width="*" />
                    <DataGridTextColumn Header="{Binding Data.Loc[Col_Teeth], Source={StaticResource Proxy}}" Binding="{Binding TeethText}" Width="*" />
                    <DataGridTextColumn Header="{Binding Data.Loc[Col_Expected], Source={StaticResource Proxy}}" Binding="{Binding ExpectedText}" Width="120" />
                    <DataGridTemplateColumn Header="{Binding Data.Loc[Col_Status], Source={StaticResource Proxy}}" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Status, Converter={StaticResource CaseStatusBrush}}" />
                            <TextBlock Text="{Binding Status, Converter={StaticResource CaseStatusText}}" />
                        </StackPanel>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="{Binding Data.Loc[Col_Total], Source={StaticResource Proxy}}" Binding="{Binding TotalText}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding Loc[Patient_NoCases]}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                       Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVis}}" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource GhostButton}" Content="{Binding Loc[Common_Close]}" Command="{Binding CloseCommand}" />
        </StackPanel>
    </StackPanel>
</views:DialogWindowBase>
