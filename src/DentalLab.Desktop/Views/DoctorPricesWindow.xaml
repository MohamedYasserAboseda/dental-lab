<views:DialogWindowBase x:Class="DentalLab.Desktop.Views.DoctorPricesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DentalLab.Desktop.Views" xmlns:helpers="clr-namespace:DentalLab.Desktop.Helpers" xmlns:controls="clr-namespace:DentalLab.Desktop.Controls" xmlns:vm="clr-namespace:DentalLab.Desktop.ViewModels"
        Style="{StaticResource DialogWindow}" Width="600">
    <views:DialogWindowBase.Resources><helpers:BindingProxy x:Key="Proxy" Data="{Binding}" /></views:DialogWindowBase.Resources>
    <StackPanel>
            <TextBlock Text="{Binding Loc[Prices_Hint]}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />
            <DataGrid Style="{StaticResource PremiumDataGrid}" ItemsSource="{Binding Rows}" MaxHeight="380" VerticalScrollBarVisibility="Auto" RowHeight="50">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding Data.Loc[Col_Restoration], Source={StaticResource Proxy}}" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="{Binding Data.Loc[Col_Price], Source={StaticResource Proxy}}" Binding="{Binding DefaultText}" Width="120" />
                    <DataGridTemplateColumn Header="{Binding Data.Loc[Col_DoctorPrice], Source={StaticResource Proxy}}" Width="150">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <TextBox Style="{StaticResource FieldTextBox}" Padding="10,6" FlowDirection="LeftToRight" Height="36"
                                     Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,14,0,0">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                    <DataTrigger Binding="{Binding ErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style></TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Style="{StaticResource GhostButton}" Content="{Binding Loc[Common_Cancel]}" Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="{Binding Loc[Common_Save]}" Command="{Binding SaveCommand}" />
            </StackPanel>
    </StackPanel>
</views:DialogWindowBase>
