<UserControl x:Class="DentalLab.Desktop.Views.DoctorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DentalLab.Desktop.ViewModels"
             xmlns:views="clr-namespace:DentalLab.Desktop.Views"
             xmlns:helpers="clr-namespace:DentalLab.Desktop.Helpers">
    <UserControl.Resources>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <DataTemplate DataType="{x:Type vm:DoctorProfileViewModel}">
            <views:DoctorProfileView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="ListPanel">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProfileOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="{Binding Loc[Nav_Doctors]}" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"
                        HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Loc[Doctors_Add]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Height="44" Width="380" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="14,0,8,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding Loc[Doctors_Search]}" IsHitTestVisible="False" VerticalAlignment="Center"
                                       Margin="2,0,0,0" Foreground="{DynamicResource TextMutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="4" HorizontalAlignment="Right" Height="44">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="DoctorFilter" Style="{StaticResource SegmentedRadio}"
                                     Content="{Binding Loc[Filter_All]}" IsChecked="{Binding IsFilterAll, Mode=TwoWay}" />
                        <RadioButton GroupName="DoctorFilter" Style="{StaticResource SegmentedRadio}"
                                     Content="{Binding Loc[Filter_Active]}" IsChecked="{Binding IsFilterActive, Mode=TwoWay}" />
                        <RadioButton GroupName="DoctorFilter" Style="{StaticResource SegmentedRadio}"
                                     Content="{Binding Loc[Filter_Inactive]}" IsChecked="{Binding IsFilterInactive, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <DataGrid Style="{StaticResource PremiumDataGrid}" ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding SelectedDoctor, Mode=TwoWay}">
                            <DataGrid.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenProfileCommand}"
                                              CommandParameter="{Binding SelectedDoctor}" />
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Data.Loc[Col_Code], Source={StaticResource Proxy}}"
                                                    Binding="{Binding Code}" Width="90" />
                                <DataGridTextColumn Header="{Binding Data.Loc[Col_Name], Source={StaticResource Proxy}}"
                                                    Binding="{Binding FullName}" Width="2*" />
                                <DataGridTextColumn Header="{Binding Data.Loc[Col_Clinic], Source={StaticResource Proxy}}"
                                                    Binding="{Binding ClinicName}" Width="1.5*" />
                                <DataGridTextColumn Header="{Binding Data.Loc[Col_Phone], Source={StaticResource Proxy}}"
                                                    Binding="{Binding Phone}" Width="150" />
                                <DataGridTemplateColumn Header="{Binding Data.Loc[Col_Balance], Source={StaticResource Proxy}}" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Balance, StringFormat=N2}" FontWeight="SemiBold"
                                                       Foreground="{Binding Balance, Converter={StaticResource BalanceBrush}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding Data.Loc[Col_Status], Source={StaticResource Proxy}}" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding IsActive, Converter={StaticResource StatusText}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="96">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE7B3;" Width="34" Height="34" FontSize="14"
                                                        Command="{Binding DataContext.OpenProfileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource IconButton}" Content="&#xE70F;" Width="34" Height="34" FontSize="14"
                                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <Viewbox Width="72" Height="72" Margin="0,0,0,14">
                                <Path Data="{StaticResource ToothGeometry}" Stroke="{StaticResource GoldBrush}"
                                      StrokeThickness="2.5" StrokeLineJoin="Round" Width="100" Height="100" Stretch="Uniform" />
                            </Viewbox>
                            <TextBlock Text="{Binding EmptyMessage}" Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="14" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,6">
                        <Button Style="{StaticResource IconButton}" Content="{Binding PrevGlyph}" Command="{Binding PreviousPageCommand}" />
                        <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Margin="12,0"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <Button Style="{StaticResource IconButton}" Content="{Binding NextGlyph}" Command="{Binding NextPageCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <ContentControl x:Name="ProfileHost" Content="{Binding Profile}"
                        Visibility="{Binding IsProfileOpen, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
