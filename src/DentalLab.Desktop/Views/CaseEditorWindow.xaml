<views:DialogWindowBase x:Class="DentalLab.Desktop.Views.CaseEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DentalLab.Desktop.Views" xmlns:helpers="clr-namespace:DentalLab.Desktop.Helpers" xmlns:controls="clr-namespace:DentalLab.Desktop.Controls" xmlns:vm="clr-namespace:DentalLab.Desktop.ViewModels"
        Style="{StaticResource DialogWindow}" Width="1120">
    
    <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="440" />
                </Grid.ColumnDefinitions>

                <controls:DentalChartControl Grid.Column="0" MinHeight="470" VerticalAlignment="Top"
                                             SelectedTeeth="{Binding SelectedTeeth, Mode=TwoWay}" />

                <StackPanel Grid.Column="2">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Doctor]}" /><ComboBox Style="{StaticResource PremiumComboBox}" ItemsSource="{Binding Doctors}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedDoctorId}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Patient]}" /><ComboBox Style="{StaticResource PremiumComboBox}" ItemsSource="{Binding Patients}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedPatientId}" /></StackPanel></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Restoration]}" /><ComboBox Style="{StaticResource PremiumComboBox}" ItemsSource="{Binding Types}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedTypeId}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Material]}" /><ComboBox Style="{StaticResource PremiumComboBox}" ItemsSource="{Binding Materials}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedMaterialId}" /></StackPanel></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Shade]}" /><TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Shade, UpdateSourceTrigger=PropertyChanged}"  /></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Quantity]}" /><TextBox Style="{StaticResource FieldTextBox}" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" /></StackPanel></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_UnitPrice]}" /><TextBox Style="{StaticResource FieldTextBox}" Text="{Binding UnitPriceText, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Discount]}" /><TextBox Style="{StaticResource FieldTextBox}" Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" /></StackPanel></Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_ExpectedDate]}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding ExpectedDateText, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Style="{StaticResource GhostButton}" Height="42" MinWidth="44" Padding="8,0" Content="+3" Command="{Binding AddDaysCommand}" CommandParameter="3" Margin="0,0,4,0" />
                            <Button Style="{StaticResource GhostButton}" Height="42" MinWidth="44" Padding="8,0" Content="+7" Command="{Binding AddDaysCommand}" CommandParameter="7" Margin="0,0,4,0" />
                            <Button Style="{StaticResource GhostButton}" Height="42" MinWidth="44" Padding="8,0" Content="+14" Command="{Binding AddDaysCommand}" CommandParameter="14" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Notes]}" />
                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" VerticalContentAlignment="Top" />
                    <Border Background="{DynamicResource BgBrush}" CornerRadius="12" Padding="16,10" Margin="0,16,0,0">
                        <Grid>
                            <TextBlock Text="{Binding Loc[Field_Total]}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,14,0,0">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                    <DataTrigger Binding="{Binding ErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style></TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Style="{StaticResource GhostButton}" Content="{Binding Loc[Common_Cancel]}" Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="{Binding Loc[Common_Save]}" Command="{Binding SaveCommand}" />
            </StackPanel>
    </StackPanel>
</views:DialogWindowBase>
