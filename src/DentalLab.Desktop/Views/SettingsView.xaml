<UserControl x:Class="DentalLab.Desktop.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svc="clr-namespace:DentalLab.Desktop.Services" xmlns:views="clr-namespace:DentalLab.Desktop.Views" xmlns:helpers="clr-namespace:DentalLab.Desktop.Helpers" xmlns:controls="clr-namespace:DentalLab.Desktop.Controls" xmlns:vm="clr-namespace:DentalLab.Desktop.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding Loc[Nav_Settings]}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,18" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Settings_Appearance]}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <CheckBox Content="{Binding Loc[Settings_ReduceMotion]}" IsChecked="{Binding ReduceMotion, Mode=TwoWay}" Margin="0,12,0,0" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="{Binding Loc[Settings_ReduceMotionHint]}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16" DataContext="{Binding Lab}">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Lab_Title]}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Lab_Name]}" /><TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"  />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Address]}" /><TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"  />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Phone]}" /><TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Email]}" /><TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" /></StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Lab_Currency]}" /><TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" MaxWidth="200" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Lab_Logo]}" />
                            <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Height="110" Padding="8">
                                <Grid>
                                    <Image Source="{Binding LogoImage}" Stretch="Uniform" />
                                    <TextBlock Text="{Binding Loc[Lab_NoLogo]}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                                            <DataTrigger Binding="{Binding HasLogo}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource GhostButton}" Height="36" Content="{Binding Loc[Lab_ChooseLogo]}" Command="{Binding ChooseLogoCommand}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource GhostButton}" Height="36" Content="{Binding Loc[Lab_ClearLogo]}" Command="{Binding ClearLogoCommand}" Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Lab_DefaultFormat]}" />
                            <ComboBox Style="{StaticResource PremiumComboBox}" ItemsSource="{Binding FormatOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding FormatId, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Lab_DocLanguage]}" />
                            <ComboBox Style="{StaticResource PremiumComboBox}" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding LanguageMode, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding Loc[Common_Save]}" Command="{Binding SaveCommand}" />
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="14,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"
                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Height="470" DataContext="{Binding Catalog}">
                <Border.Resources><helpers:BindingProxy x:Key="Proxy" Data="{Binding}" /></Border.Resources>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="{Binding Loc[Settings_Catalog]}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="3" Height="42" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="CatalogKind" Style="{StaticResource SegmentedRadio}" Content="{Binding Loc[Catalog_Types]}" IsChecked="{Binding IsRestoration, Mode=TwoWay}" />
                                    <RadioButton GroupName="CatalogKind" Style="{StaticResource SegmentedRadio}" Content="{Binding Loc[Catalog_Materials]}" IsChecked="{Binding IsMaterials, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding Loc[Catalog_Add]}" Command="{Binding AddCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Loc[Catalog_PriceHint]}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid Grid.Row="2" Style="{StaticResource PremiumDataGrid}" ItemsSource="{Binding Items}" RowHeight="46" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Data.Loc[Field_Name], Source={StaticResource Proxy}}" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="{Binding Data.Loc[Col_NameAr], Source={StaticResource Proxy}}" Binding="{Binding NameAr}" Width="2*" />
                            <DataGridTextColumn Header="{Binding Data.Loc[Col_Price], Source={StaticResource Proxy}}" Binding="{Binding DefaultPrice, StringFormat=N2}" Width="130"
                                                Visibility="{Binding Data.IsRestoration, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}" />
                            <DataGridTemplateColumn Header="{Binding Data.Loc[Col_Status], Source={StaticResource Proxy}}" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <TextBlock Text="{Binding IsActive, Converter={StaticResource StatusText}}" />
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Button Style="{StaticResource IconButton}" Content="&#xE70F;" Width="34" Height="34" FontSize="14" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
