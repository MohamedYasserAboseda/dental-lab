<UserControl x:Class="DentalLab.Desktop.Views.CasesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DentalLab.Desktop.Views" xmlns:helpers="clr-namespace:DentalLab.Desktop.Helpers" xmlns:controls="clr-namespace:DentalLab.Desktop.Controls" xmlns:vm="clr-namespace:DentalLab.Desktop.ViewModels">
    <UserControl.Resources>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <DataTemplate DataType="{x:Type vm:CaseDetailsViewModel}"><views:CaseDetailsView /></DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="ListPanel">
            <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                <DataTrigger Binding="{Binding IsDetailsOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="{Binding Loc[Nav_Cases]}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Loc[Cases_Add]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
            <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Height="42" Width="300" Margin="0,0,12,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="14,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding Loc[Cases_Search]}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{DynamicResource TextMutedBrush}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
                <ComboBox Style="{StaticResource PremiumComboBox}" Width="190" Margin="0,0,12,10" ItemsSource="{Binding DoctorOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedDoctorId}" />
                <ComboBox Style="{StaticResource PremiumComboBox}" Width="170" Margin="0,0,12,10" ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Text" SelectedItem="{Binding SelectedStatusOption, Mode=TwoWay}" />
                <ComboBox Style="{StaticResource PremiumComboBox}" Width="160" Margin="0,0,12,10" ItemsSource="{Binding PeriodOptions}" DisplayMemberPath="Text" SelectedItem="{Binding SelectedPeriodOption, Mode=TwoWay}" />
                <CheckBox Content="{Binding Loc[Cases_OverdueOnly]}" IsChecked="{Binding OverdueOnly}" Foreground="{DynamicResource TextBrush}"
                          VerticalAlignment="Top" Margin="0,12,0,0" />
            </WrapPanel>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <DataGrid Style="{StaticResource PremiumDataGrid}" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedCase, Mode=TwoWay}">
                            <DataGrid.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenDetailsCommand}" CommandParameter="{Binding SelectedCase}" />
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Data.Loc[Col_CaseNumber], Source={StaticResource Proxy}}" Binding="{Binding CaseNumber}" Width="140" />
                                <DataGridTextColumn Header="{Binding Data.Loc[Col_Name], Source={StaticResource Proxy}}" Binding="{Binding DoctorName}" Width="1.3*" />
                                <DataGridTextColumn Header="{Binding Data.Loc[Col_Patient], Source={StaticResource Proxy}}" Binding="{Binding PatientName}" Width="1.3*" />
                                <DataGridTextColumn Header="{Binding Data.Loc[Col_Restoration], Source={StaticResource Proxy}}" Binding="{Binding RestorationText}" Width="1.1*" />
                                <DataGridTextColumn Header="{Binding Data.Loc[Col_Teeth], Source={StaticResource Proxy}}" Binding="{Binding TeethText}" Width="1*" />
                                <DataGridTemplateColumn Header="{Binding Data.Loc[Col_Expected], Source={StaticResource Proxy}}" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock Text="{Binding ExpectedText}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" /><Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding Data.Loc[Col_Status], Source={StaticResource Proxy}}" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Status, Converter={StaticResource CaseStatusBrush}}" />
                                        <TextBlock Text="{Binding Status, Converter={StaticResource CaseStatusText}}" />
                                    </StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding Data.Loc[Col_Total], Source={StaticResource Proxy}}" Binding="{Binding TotalText}" Width="110" />
                                <DataGridTemplateColumn Width="96"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE7B3;" Width="34" Height="34" FontSize="14" Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                        <Button Content="&#xE70F;" Width="34" Height="34" FontSize="14"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditable}" Value="False"><Setter Property="Visibility" Value="Hidden" /></DataTrigger>
                                            </Style.Triggers></Style></Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <Viewbox Width="72" Height="72" Margin="0,0,0,14">
                                <Path Data="{StaticResource ToothGeometry}" Stroke="{StaticResource GoldBrush}" StrokeThickness="2.5" StrokeLineJoin="Round" Width="100" Height="100" Stretch="Uniform" />
                            </Viewbox>
                            <TextBlock Text="{Binding EmptyMessage}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,6">
                        <Button Style="{StaticResource IconButton}" Content="{Binding PrevGlyph}" Command="{Binding PreviousPageCommand}" />
                        <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource TextMutedBrush}" />
                        <Button Style="{StaticResource IconButton}" Content="{Binding NextGlyph}" Command="{Binding NextPageCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <ContentControl x:Name="DetailsHost" Content="{Binding Details}" Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
