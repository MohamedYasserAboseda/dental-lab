<UserControl x:Class="DentalLab.Desktop.Views.PatientsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DentalLab.Desktop.Views" xmlns:helpers="clr-namespace:DentalLab.Desktop.Helpers" xmlns:controls="clr-namespace:DentalLab.Desktop.Controls" xmlns:vm="clr-namespace:DentalLab.Desktop.ViewModels">
    <UserControl.Resources><helpers:BindingProxy x:Key="Proxy" Data="{Binding}" /></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="{Binding Loc[Nav_Patients]}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Loc[Patients_Add]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Height="42" Width="340" Margin="0,0,12,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="14,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding Loc[Patients_Search]}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{DynamicResource TextMutedBrush}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            <ComboBox Style="{StaticResource PremiumComboBox}" Width="240" Margin="0,0,12,10" ItemsSource="{Binding DoctorOptions}"
                      DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedDoctorId}" />
        </WrapPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <DataGrid Style="{StaticResource PremiumDataGrid}" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedPatient, Mode=TwoWay}">
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" CommandParameter="{Binding SelectedPatient}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Data.Loc[Col_Patient], Source={StaticResource Proxy}}" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="{Binding Data.Loc[Col_Name], Source={StaticResource Proxy}}" Binding="{Binding DoctorName}" Width="1.5*" />
                            <DataGridTextColumn Header="{Binding Data.Loc[Field_PatientCode], Source={StaticResource Proxy}}" Binding="{Binding Code}" Width="130" />
                            <DataGridTextColumn Header="{Binding Data.Loc[Col_Cases], Source={StaticResource Proxy}}" Binding="{Binding CaseCount}" Width="90" />
                            <DataGridTemplateColumn Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Button Style="{StaticResource IconButton}" Content="&#xE81C;" Width="34" Height="34" FontSize="14" ToolTip="{Binding DataContext.Loc[Patient_History], RelativeSource={RelativeSource AncestorType=DataGrid}}" Command="{Binding DataContext.OpenHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Button Style="{StaticResource IconButton}" Content="&#xE70F;" Width="34" Height="34" FontSize="14" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <Viewbox Width="72" Height="72" Margin="0,0,0,14">
                                <Path Data="{StaticResource ToothGeometry}" Stroke="{StaticResource GoldBrush}" StrokeThickness="2.5" StrokeLineJoin="Round" Width="100" Height="100" Stretch="Uniform" />
                            </Viewbox>
                            <TextBlock Text="{Binding EmptyMessage}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" TextAlignment="Center" />
                        </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,6">
                        <Button Style="{StaticResource IconButton}" Content="{Binding PrevGlyph}" Command="{Binding PreviousPageCommand}" />
                        <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource TextMutedBrush}" />
                        <Button Style="{StaticResource IconButton}" Content="{Binding NextGlyph}" Command="{Binding NextPageCommand}" />
                    </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
