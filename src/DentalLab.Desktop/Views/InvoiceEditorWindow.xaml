<views:DialogWindowBase x:Class="DentalLab.Desktop.Views.InvoiceEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DentalLab.Desktop.Views" xmlns:helpers="clr-namespace:DentalLab.Desktop.Helpers" xmlns:controls="clr-namespace:DentalLab.Desktop.Controls" xmlns:vm="clr-namespace:DentalLab.Desktop.ViewModels"
        Style="{StaticResource DialogWindow}" Width="900">
    <views:DialogWindowBase.Resources><helpers:BindingProxy x:Key="Proxy" Data="{Binding}" /></views:DialogWindowBase.Resources>
    <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Doctor]}" />
            <ComboBox Style="{StaticResource PremiumComboBox}" ItemsSource="{Binding Doctors}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedDoctorId}" />
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Invoice_From]}" /><TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Invoice_To]}" /><TextBox Style="{StaticResource FieldTextBox}" Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" /></StackPanel>
                <Button Grid.Column="4" VerticalAlignment="Bottom" Style="{StaticResource GhostButton}" Content="{Binding Loc[Invoice_LoadCases]}" Command="{Binding ReloadCasesCommand}" />
            </Grid>
            <Grid Margin="0,14,0,6">
                <TextBlock Text="{Binding Loc[Invoice_Lines]}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Height="34" MinWidth="64" FontSize="12" Padding="12,0"
                        Content="{Binding Loc[Invoice_SelectAll]}" Command="{Binding SelectAllCommand}" />
            </Grid>
            <Grid>
                <DataGrid Style="{StaticResource PremiumDataGrid}" ItemsSource="{Binding Cases}" MaxHeight="250" RowHeight="46" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{Binding Data.Loc[Col_Selected], Source={StaticResource Proxy}}" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="{Binding Data.Loc[Col_CaseNumber], Source={StaticResource Proxy}}" Binding="{Binding CaseNumber}" Width="140" />
                        <DataGridTextColumn Header="{Binding Data.Loc[Col_Patient], Source={StaticResource Proxy}}" Binding="{Binding PatientName}" Width="1.2*" />
                        <DataGridTextColumn Header="{Binding Data.Loc[Col_Restoration], Source={StaticResource Proxy}}" Binding="{Binding RestorationText}" Width="1.1*" />
                        <DataGridTextColumn Header="{Binding Data.Loc[Col_Date], Source={StaticResource Proxy}}" Binding="{Binding DateText}" Width="110" />
                        <DataGridTextColumn Header="{Binding Data.Loc[Col_Total], Source={StaticResource Proxy}}" Binding="{Binding TotalText}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding Loc[Invoice_NoUnbilled]}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0"
                           Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding HasNoCases, Converter={StaticResource BoolToVis}}" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Discount]}" /><TextBox Style="{StaticResource FieldTextBox}" Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Invoice_Description]}" /><TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"  /></StackPanel>
            </Grid>
            <Border Background="{DynamicResource BgBrush}" CornerRadius="12" Padding="16,12" Margin="0,16,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Loc[Details_Subtotal]}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SubtotalText}" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Loc[Field_Total]}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalText}" Margin="10,0,0,0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,14,0,0">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                    <DataTrigger Binding="{Binding ErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style></TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Style="{StaticResource GhostButton}" Content="{Binding Loc[Common_Cancel]}" Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="{Binding Loc[Invoice_Create]}" Command="{Binding SaveCommand}" />
            </StackPanel>
    </StackPanel>
</views:DialogWindowBase>
