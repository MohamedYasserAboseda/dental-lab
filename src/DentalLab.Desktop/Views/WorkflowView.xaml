<UserControl x:Class="DentalLab.Desktop.Views.WorkflowView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DentalLab.Desktop.Views" xmlns:helpers="clr-namespace:DentalLab.Desktop.Helpers" xmlns:controls="clr-namespace:DentalLab.Desktop.Controls" xmlns:vm="clr-namespace:DentalLab.Desktop.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Loc[Nav_Workflow]}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ComboBox Style="{StaticResource PremiumComboBox}" Width="220" Margin="0,0,12,0" ItemsSource="{Binding DoctorOptions}"
                          DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedDoctorId}" />
                <CheckBox Content="{Binding Loc[Cases_OverdueOnly]}" IsChecked="{Binding OverdueOnly}" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextBrush}" />
                <Button Style="{StaticResource GhostButton}" Content="{Binding Loc[Dash_Refresh]}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Stats}" Margin="0,0,-12,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                <controls:AnimatedNumber Value="{Binding Value}" Decimals="{Binding Decimals}" FontSize="24" FontWeight="Bold" Foreground="{Binding Accent}" />
                                <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <Grid Grid.Column="1" Width="34" Height="34" VerticalAlignment="Top">
                                <Border CornerRadius="10" Background="{Binding Accent}" Opacity="0.16" />
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="{StaticResource DangerBrush}" Margin="2,0,0,8" TextWrapping="Wrap" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />

        <Grid Grid.Row="3" x:Name="BoardHost">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="290" Margin="0,0,14,6" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid Margin="2,0,2,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="{Binding Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextBrush}" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" CornerRadius="10" Background="{DynamicResource BgBrush}" Padding="9,2">
                                            <TextBlock Text="{Binding Count}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                        </Border>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Cards}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource BgBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <TextBlock Text="{Binding CaseNumber}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                                                    <TextBlock Text="{Binding ExpectedText}" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextMutedBrush}">
                                                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                                                                        </Style.Triggers></Style></TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                                <TextBlock Text="{Binding PatientName}" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding DoctorName}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                                    <Run Text="{Binding RestorationText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding TeethText, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <Grid Margin="0,10,0,0">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                    <Button Style="{StaticResource PrimaryButton}" Height="32" FontSize="12" Padding="10,0" Content="{Binding NextText}"
                                                                            Visibility="{Binding HasNext, Converter={StaticResource BoolToVis}}"
                                                                            Command="{Binding DataContext.AdvanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE749;" Width="32" Height="32" FontSize="14" Margin="6,0,0,0"
                                                                            Command="{Binding DataContext.PrintWorkOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding DataContext.Loc[Workflow_Empty], RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,16">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cards.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                </Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
