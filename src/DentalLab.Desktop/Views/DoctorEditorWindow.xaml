<Window x:Class="DentalLab.Desktop.Views.DoctorEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:DentalLab.Desktop.Services"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" SizeToContent="Height" Width="600" WindowStartupLocation="CenterOwner"
        FlowDirection="{Binding FlowDirection, Source={x:Static svc:LocalizationService.Instance}}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>
    <Grid x:Name="Root" Margin="20">
        <Border x:Name="Card" Background="{DynamicResource SurfaceBrush}" CornerRadius="20" Padding="28"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="CardScale" /></Border.RenderTransform>
            <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.3" Color="Black" /></Border.Effect>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,20" Cursor="SizeAll" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_FullName]}" />
                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Clinic]}" />
                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding ClinicName, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Phone]}" />
                        <TextBox Style="{StaticResource FieldTextBox}" FlowDirection="LeftToRight"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Email]}" />
                        <TextBox Style="{StaticResource FieldTextBox}" FlowDirection="LeftToRight"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Address]}" />
                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_Notes]}" />
                <TextBox Style="{StaticResource FieldTextBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                         VerticalContentAlignment="Top" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Loc[Field_OpeningBalance]}" />
                    <TextBox Style="{StaticResource FieldTextBox}" FlowDirection="LeftToRight"
                             Text="{Binding OpeningBalanceText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding Loc[Editor_OpeningBalanceHint]}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="2,6,0,0" />
                </StackPanel>

                <CheckBox Content="{Binding Loc[Field_Active]}" IsChecked="{Binding IsActive}" Margin="0,16,0,0"
                          Foreground="{DynamicResource TextBrush}" />

                <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           Margin="0,14,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="{Binding Loc[Common_Cancel]}"
                            Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding Loc[Common_Save]}"
                            Command="{Binding SaveCommand}" IsDefault="False" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
