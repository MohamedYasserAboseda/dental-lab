<UserControl x:Class="DentalLab.Desktop.Views.DoctorAccountsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DentalLab.Desktop.Views" xmlns:helpers="clr-namespace:DentalLab.Desktop.Helpers" xmlns:controls="clr-namespace:DentalLab.Desktop.Controls" xmlns:vm="clr-namespace:DentalLab.Desktop.ViewModels">
    <UserControl.Resources><helpers:BindingProxy x:Key="Proxy" Data="{Binding}" /></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TextBlock Text="{Binding Loc[Nav_DoctorAccounts]}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,18" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="400" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource BgBrush}" CornerRadius="12" Padding="12,10"><StackPanel>
                            <TextBlock Text="{Binding Loc[Accounts_Outstanding]}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding OutstandingText}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                        </StackPanel></Border>
                        <Border Grid.Column="2" Background="{DynamicResource BgBrush}" CornerRadius="12" Padding="12,10"><StackPanel>
                            <TextBlock Text="{Binding Loc[Accounts_Credit]}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CreditText}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                        </StackPanel></Border>
                    </Grid>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Height="42" Margin="0,0,0,8" HorizontalAlignment="Stretch" Grid.Row="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="14,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding Loc[Accounts_Search]}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{DynamicResource TextMutedBrush}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
                    <CheckBox Grid.Row="2" Content="{Binding Loc[Accounts_OutstandingOnly]}" IsChecked="{Binding BalancesOnly}" Foreground="{DynamicResource TextBrush}" Margin="2,0,0,8" />
                    <DataGrid Grid.Row="3" Style="{StaticResource PremiumDataGrid}" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedDoctor, Mode=TwoWay}" RowHeight="48">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Data.Loc[Col_Name], Source={StaticResource Proxy}}" Binding="{Binding FullName}" Width="*" />
                            <DataGridTemplateColumn Header="{Binding Data.Loc[Col_Balance], Source={StaticResource Proxy}}" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <TextBlock Text="{Binding Balance, StringFormat=N2}" FontWeight="SemiBold" Foreground="{Binding Balance, Converter={StaticResource BalanceBrush}}" />
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18,22,14">
                <Grid>
                    <TextBlock Text="{Binding Loc[Accounts_Select]}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVis}}" />
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedName}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Loc[Profile_Balance]}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedBalanceText}" Margin="10,0,0,0" FontSize="24" FontWeight="Bold"
                                               Foreground="{Binding SelectedBalance, Converter={StaticResource BalanceBrush}}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}" Content="{Binding Loc[Doc_PrintStatement]}" Command="{Binding PrintStatementCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource GhostButton}" Content="{Binding Loc[Accounts_AddAdjustment]}" Command="{Binding AddAdjustmentCommand}" Margin="0,0,10,0" />
                                <Button Style="{StaticResource PrimaryButton}" Content="{Binding Loc[Payments_Add]}" Command="{Binding AddPaymentCommand}" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <DataGrid Style="{StaticResource PremiumDataGrid}" ItemsSource="{Binding Lines}" RowHeight="46">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding Data.Loc[Col_Date], Source={StaticResource Proxy}}" Binding="{Binding DateText}" Width="150" />
                                    <DataGridTextColumn Header="{Binding Data.Loc[Col_Type], Source={StaticResource Proxy}}" Binding="{Binding Type, Converter={StaticResource LedgerTypeText}}" Width="140" />
                                    <DataGridTextColumn Header="{Binding Data.Loc[Col_Description], Source={StaticResource Proxy}}" Binding="{Binding Description}" Width="*" />
                                    <DataGridTextColumn Header="{Binding Data.Loc[Col_Debit], Source={StaticResource Proxy}}" Binding="{Binding DebitText}" Width="100" />
                                    <DataGridTextColumn Header="{Binding Data.Loc[Col_Credit], Source={StaticResource Proxy}}" Binding="{Binding CreditText}" Width="100" />
                                    <DataGridTextColumn Header="{Binding Data.Loc[Col_RunningBalance], Source={StaticResource Proxy}}" Binding="{Binding RunningText}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{Binding Loc[Profile_StatementEmpty]}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding HasNoLines, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
